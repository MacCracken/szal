[package]
name = "szal"
version = "0.1.0"
description = "szal — Cyrius port (from 13172 lines of Rust)"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.1.33"

[build]
entry = "src/main.cyr"
output = "szal"

[deps]
stdlib = ["string", "fmt", "alloc", "vec", "str", "syscalls", "io", "args", "assert"]
