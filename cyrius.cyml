[package]
name = "szal"
version = "${file:VERSION}"
description = "szal — workflow engine: step/flow execution with branching, retry, rollback, DAG and parallel stages"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/szal"
language = "cyrius"
cyrius = "6.6.6"

[build]
entry = "src/main.cyr"
output = "build/szal"

# Consumer bundle: dist/szal-mcp.cyr (+ dist/szal-mcp.deps) = the 54 MCP tools for a consumer that
# already owns a bote dispatcher (hoosh). ONLY szal's own modules that szal_all_tools() reaches, in
# single-pass order — no bote-core / majra / ai-hwaccel / stdlib, which the consumer supplies.
# src/mcp_bundle.cyr is a comment-only header carrying that contract into the vendored file.
# Regenerate with `cyrius distlib mcp` and commit dist/; CI regenerates it and fails on any diff
# (`distlib --check` cannot target one profile and insists on a base bundle), then builds
# tests/szal_consumer_bundle.tcyr against it. The full [lib] / [lib.core] profiles (dist/szal.cyr,
# dist/szal-core.cyr) remain M5 — port-plan.md §5 — and need majra / ai-hwaccel declared: their
# engine modules name those libs' enum constants, which distlib's standalone compile check refuses.
[lib.mcp]
modules = [
    "src/mcp_bundle.cyr",
    "src/error.cyr",
    "src/state.cyr",
    "src/uuid.cyr",
    "src/md5.cyr",
    "src/step.cyr",
    "src/condition.cyr",
    "src/flow.cyr",
    "src/mcp.cyr",
    "src/mcp_pool.cyr",
    "src/mcp_tools_encoding.cyr",
    "src/mcp_tools_hash.cyr",
    "src/mcp_tools_system.cyr",
    "src/mcp_tools_json.cyr",
    "src/mcp_tools_template.cyr",
    "src/mcp_tools_conversion.cyr",
    "src/mcp_tools_math.cyr",
    "src/mcp_tools_state.cyr",
    "src/mcp_tools_step.cyr",
    "src/mcp_tools_flow.cyr",
    "src/mcp_tools_engine.cyr",
    "src/mcp_tools_file.cyr",
    "src/mcp_tools_process.cyr",
    "src/mcp_tools_git.cyr",
    "src/mcp_tools_net.cyr",
]

[deps]
# Human-readable stdlib record (cyrius 6.x: `cyrius lib sync` provisions ./lib/).
# NO "json"/"base64"/"toml" here — carved into bayan (opt-in include). NO "slice"/"ct"
# (not separately resolvable — lib sync provides them).
stdlib = ["string", "fmt", "alloc", "freelist", "vec", "str", "syscalls", "io", "fs",
          "args", "assert", "test", "hashmap", "tagged", "result", "fnptr", "chrono",
          "thread", "sync", "async", "atomic", "process", "net", "random", "log",
          "sakshi", "patra", "sigil", "ct", "keccak", "bayan", "bench"]

# bote-core + majra + ai-hwaccel are ALL VENDORED at src/vendor/ (hoosh pattern). A [deps.X] block
# would make `cyrius deps` recurse into each dep's own git sub-deps (lib/ bloat + last-definition-
# wins symbol collisions), and for ai-hwaccel specifically, declaring it as a git dep puts the build
# on the FULL-DEPS path, which on x86_64 mis-resolves szal's `var buf[ENUM_CONST]` idiom (error.cyr).
#
# Pins at 2.1.1 — every one at its latest upstream release:
#   majra       2.7.0   dist/majra.cyr        -> scripts/sync-majra.sh       (6 collision renames)
#   bote-core   3.3.7   dist/bote-core.cyr    -> scripts/sync-bote.sh        (1 collision rename)
#   ai-hwaccel  2.3.19  dist/ai-hwaccel.cyr   -> scripts/sync-ai-hwaccel.sh  (no renames)
#
# With all three vendored, szal has ZERO git deps -> CI is `cyrius lib sync` (stdlib only) +
# `cyrius build --strict --no-deps` (the project build recipe). No `cyrius deps` / cyrius.lock.
# Full rationale: docs/development/majra-vendoring.md.
#
# COLLISION STATUS at 2.1.1 — run `scripts/scan-collisions.sh` to reproduce; it is the authority,
# NOT the compiler. `cyrius build --strict --no-deps src/main.cyr` reports zero duplicate symbols,
# but that is much weaker than it reads: cycc is blind to fn-vs-var, fn-vs-enum-constant,
# struct-vs-struct and enum-type-vs-enum-type collisions entirely, and to EVERY value conflict whose
# prior definition sits past var-table index 1024 (over half of szal's globals). The scanner covers
# all kinds, cross-kind, across szal x majra x bote x ai-hwaccel x the provisioned stdlib.
#
# Three intersections remain, all intentional or verified-benign:
#   REQ_NONE                  szal src/step.cyr:48 x ai-hwaccel — the SHARED hardware-requirement
#                             API, both = 0, deliberately one symbol.
#   StepStatus / TriggerMode  enum TYPE names, szal src/step.cyr:26,35 x majra. Cyrius does not put
#                             enum type names in the flat symbol table, and neither is used as a
#                             type annotation in szal.
# NEW at 2.1.1: SYS_GETRANDOM (majra `var` 318, x86-hardcoded, vs the stdlib's ARCH-CONDITIONAL enum
# constant 318/278/45) is now renamed MJ_SYS_GETRANDOM by sync-majra.sh. It was invisible to every
# previous scan — cross-kind, and value-identical on the CI arch, so cycc said nothing.
