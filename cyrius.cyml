[package]
name = "szal"
version = "${file:VERSION}"
description = "szal — workflow engine: step/flow execution with branching, retry, rollback, DAG and parallel stages"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/szal"
language = "cyrius"
cyrius = "6.5.2"

[build]
entry = "src/main.cyr"
output = "build/szal"

# [lib] / [lib.core] dist-bundle module lists are added at `cyrius distlib` time (M5).
# The authoritative target lists live in docs/development/port-plan.md §5; they are grown
# here incrementally as modules land so the manifest never references a nonexistent file.

[deps]
# Human-readable stdlib record (cyrius 6.x: `cyrius lib sync` provisions ./lib/).
# NO "json"/"base64"/"toml" here — carved into bayan (opt-in include). NO "slice"/"ct"
# (not separately resolvable — lib sync provides them).
stdlib = ["string", "fmt", "alloc", "freelist", "vec", "str", "syscalls", "io", "fs",
          "args", "assert", "test", "hashmap", "tagged", "result", "fnptr", "chrono",
          "thread", "sync", "async", "atomic", "process", "net", "random", "log",
          "sakshi", "patra", "sigil", "bayan", "bench"]

# bote-core + majra are VENDORED at src/vendor/ (hoosh pattern): a [deps.bote] block would
# make `cyrius deps` recurse into bote's own [deps.libro]/[deps.majra] git blocks (lib/ bloat
# + last-definition-wins symbol collisions). Pins: bote 3.1.4 dist/bote-core.cyr,
# majra 2.5.3 dist/majra.cyr -- re-synced by scripts/sync-bote.sh / sync-majra.sh.
#
# FULL majra dist is VENDORED at src/vendor/majra.cyr (majra 2.5.3, synced by scripts/sync-majra.sh
# with the szal-collision rename: MJ_ERR_/MJ_STEP_/MJ_TRIGGER_ + majra_uuid_generate/
# majra_step_result_new). main.cyr includes it after lib/thread.cyr (its only extra stdlib dep).
# bote-core 3.1.4 vendored at src/vendor/bote-core.cyr (M3 MCP; its registry_new→tool_registry_new
# rename dissolved the Q9 ai-hwaccel collision). Full rationale: docs/development/majra-vendoring.md.
#
# ai-hwaccel 2.3.15 is ALSO VENDORED at src/vendor/ai-hwaccel.cyr (scripts/sync-ai-hwaccel.sh) — the
# former [deps.ai-hwaccel] block was removed: as a git dep, `cyrius build` resolves it on the
# full-deps path, which on x86_64 mis-resolves szal's `var buf[ENUM_CONST]` idiom (error.cyr). With
# all three (majra/bote-core/ai-hwaccel) vendored, szal has ZERO git deps -> CI is `cyrius lib sync`
# (stdlib only) + `cyrius build --strict --no-deps` (the project build recipe). No `cyrius deps` /
# cyrius.lock needed.
#
# Collision status at 2.1.0 (full fn/const/var scan of szal x majra x bote x hw x stdlib): the ONLY
# remaining intersection anywhere is REQ_NONE, part of the REQ_*/FAMILY_* hardware-requirement API
# that ai-hwaccel SHARES with src/step.cyr by design. The old ERR_NONE / ERR_PARSE /
# ERR_TOOL_NOT_FOUND / ERR_TIMEOUT / BYTES_PER_GB duplicate-symbol warnings are all gone: szal
# prefixed its own codes SZAL_ERR_* + SZAL_BYTES_PER_* at 2.1.0, and bote 3.1.4 / ai-hwaccel 2.3.15 /
# sigil 6.5.2 independently prefixed theirs BOTE_ERR_* / HWA_ERR_* / SIGIL_ERR_*. `cyrius build
# --strict --no-deps src/main.cyr` now reports ZERO duplicate symbols.
