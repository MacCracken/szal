[package]
name = "szal"
version = "${file:VERSION}"
description = "szal — workflow engine: step/flow execution with branching, retry, rollback, DAG and parallel stages"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/szal"
language = "cyrius"
cyrius = "6.6.20"

[build]
entry = "src/main.cyr"
output = "build/szal"

# Consumer bundle: dist/szal-mcp.cyr (+ dist/szal-mcp.deps) = the 54 MCP tools for a consumer that
# already owns a bote dispatcher (hoosh). ONLY szal's own modules that szal_all_tools() reaches, in
# single-pass order — no bote-core / majra / ai-hwaccel / stdlib, which the consumer supplies.
# src/mcp_bundle.cyr is the header carrying that contract into the vendored file; its one line of
# code, `include "lib/io.cyr"`, seeds distlib's sidecar verify so dist/szal-mcp.deps is the same on
# every host (cyrius 6.6.20 attributes a name two stdlib leaves declare in filesystem order).
# Regenerate with `cyrius distlib mcp` and commit dist/; CI regenerates it and fails on any diff
# (`distlib --check` cannot target one profile and insists on a base bundle), then builds
# tests/szal_consumer_bundle.tcyr against it. The full [lib] / [lib.core] profiles (dist/szal.cyr,
# dist/szal-core.cyr) remain M5 — port-plan.md §5 — and need majra / ai-hwaccel declared: their
# engine modules name those libs' enum constants, which distlib's standalone compile check refuses.
[lib.mcp]
modules = [
    "src/mcp_bundle.cyr",
    "src/error.cyr",
    "src/state.cyr",
    "src/uuid.cyr",
    "src/md5.cyr",
    "src/step.cyr",
    "src/condition.cyr",
    "src/flow.cyr",
    "src/mcp.cyr",
    "src/mcp_pool.cyr",
    "src/mcp_tools_encoding.cyr",
    "src/mcp_tools_hash.cyr",
    "src/mcp_tools_system.cyr",
    "src/mcp_tools_json.cyr",
    "src/mcp_tools_template.cyr",
    "src/mcp_tools_conversion.cyr",
    "src/mcp_tools_math.cyr",
    "src/mcp_tools_state.cyr",
    "src/mcp_tools_step.cyr",
    "src/mcp_tools_flow.cyr",
    "src/mcp_tools_engine.cyr",
    "src/mcp_tools_file.cyr",
    "src/mcp_tools_process.cyr",
    "src/mcp_tools_git.cyr",
    "src/mcp_tools_net.cyr",
]

[deps]
# Human-readable stdlib record (cyrius 6.x: `cyrius lib sync` provisions ./lib/).
# NO "json"/"base64"/"toml" here — carved into bayan (opt-in include). NO "slice"/"ct"
# (not separately resolvable — lib sync provides them).
stdlib = ["string", "fmt", "alloc", "freelist", "vec", "str", "syscalls", "io", "fs",
          "args", "assert", "test", "hashmap", "tagged", "result", "fnptr", "chrono",
          "thread", "sync", "async", "atomic", "process", "net", "random", "log",
          "sakshi", "patra", "sigil", "ct", "keccak", "bayan", "bench"]

# bote-core + majra + ai-hwaccel are ALL VENDORED at src/vendor/ (hoosh pattern). A [deps.X] block
# would make `cyrius deps` recurse into each dep's own git sub-deps (lib/ bloat + last-definition-
# wins symbol collisions).
#
# Pins at 2.2.1 — each at its LAST release pinned to cyrius 6.6.20 (the next release of each moves
# to cyrius 6.7.x), vendored byte-for-byte from the tag; the same files hoosh 2.8.2 commits:
#   majra       2.9.3   dist/majra.cyr        -> scripts/sync-majra.sh
#   bote-core   3.3.17  dist/bote-core.cyr    -> scripts/sync-bote.sh
#   ai-hwaccel  2.4.2   dist/ai-hwaccel.cyr   -> scripts/sync-ai-hwaccel.sh
# Nothing is renamed inside a copy since 2.2.0 — szal renames its own side (ADR 0002).
#
# With all three vendored, szal has ZERO git deps -> CI is `cyrius lib sync` (stdlib only) +
# `cyrius build --strict --no-deps` (the project build recipe). No `cyrius deps`. From cyrius 6.6.20
# `cyrius build` writes cyrius.lock — the hashes of the provisioned stdlib files plus a
# `cyrius <pin>` trailer — and it is committed, as majra / bote / ai-hwaccel / hoosh commit theirs.
# Full rationale: docs/development/majra-vendoring.md.
#
# COLLISIONS — `scripts/scan-collisions.sh --check` is the authority, NOT the compiler: cycc is blind
# to fn-vs-var, fn-vs-enum-constant, struct-vs-struct and enum-type-vs-enum-type collisions, and to
# value-identical duplicates (until cyrius 6.6.8 it also missed every enum-constant conflict past
# var-table index 1024). The scanner covers all kinds, cross-kind, across szal x majra x bote x
# ai-hwaccel x the provisioned stdlib, and szal x szal. One intersection remains: REQ_NONE
# (src/step.cyr x ai-hwaccel, both 0) — the shared hardware-requirement API, deliberately one
# symbol, allow-listed only while the two values agree.
