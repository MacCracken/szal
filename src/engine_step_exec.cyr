# engine_step_exec.cyr — execute one step with retry, backoff, and a per-attempt timeout
#
# Ports rust-old/src/engine/step_exec.rs (execute_step_with_handler). port-plan §4 row 12.
#
# Timeout model (port-plan §1.7): Rust wraps each attempt in `tokio::time::timeout` (async, drops
# the future on deadline). Cyrius has a cooperative async runtime (lib/async.cyr) but its
# `async_timeout` FORKS a child process — a step mutates shared state, so the mutations would be
# lost. The prescribed approach is therefore a **worker thread + chan_try_recv deadline poll**:
# run the handler on a worker thread, poll its result channel until it completes or `clock_now_ms()`
# passes the deadline. On timeout we return StepTimeout ON TIME, but the orphaned worker thread runs
# to completion — OS threads cannot be force-aborted (true of std::thread; tokio only cancels at
# await points). This is the cooperative-cancel delta — see docs/development/parity-notes.md §8.
#
# Concurrency scope: in sequential use the main thread only POLLS while the worker runs (no
# concurrent allocation), so the shared allocator + the no-global-error-buffer handler ABI are safe.
# Parallel execution (row 14) will need a thread-safe allocator + per-worker error isolation.
#
# Usage: include "src/engine_step_exec.cyr" (after engine_core, bus, step, metrics; + lib/thread,
#   lib/chrono, lib/async or lib/thread for the primitives).
# Naming: public symbol is execute_step_with_handler; internal helpers use _.

# Worker-thread argument: {handler callback, step, result channel}.
enum StepWorkerL {
    SW_SIZE = 24;
    SW_HANDLER = 0;
    SW_STEP = 8;
    SW_CHAN = 16;
}

# Worker thread body: invoke the handler and send its Result down the channel. The Result is a
# heap blob (Ok(json_v) / Err(message_Str)) on the shared heap, valid for the main thread to read.
fn _step_worker(arg) {
    var r = handler_invoke(load64(arg + SW_HANDLER), load64(arg + SW_STEP));
    chan_send(load64(arg + SW_CHAN), r);
    return 0;
}

# Run a single handler attempt under a per-attempt timeout. Returns the handler Result
# (Ok(json_v)/Err(message_Str)), or 0 to signal a timeout. timeout_ms == STEP_I64_MAX means "no
# timeout" (Rust's u64::MAX) and runs the handler synchronously on the calling thread. Mirrors the
# `if step.timeout_ms < u64::MAX { timeout(...) } else { fut.await }` branch (step_exec.rs 35-60).
fn _run_attempt(handler, step, timeout_ms) {
    if (timeout_ms >= STEP_I64_MAX) {
        return handler_invoke(handler, step);
    }
    var chan = chan_new(1);
    var arg = alloc(SW_SIZE);
    store64(arg + SW_HANDLER, handler);
    store64(arg + SW_STEP, step);
    store64(arg + SW_CHAN, chan);
    var t = thread_create(&_step_worker, arg);
    var deadline = clock_now_ms() + timeout_ms;
    while (1 == 1) {
        var r = chan_try_recv(chan);
        if (r != 0) {
            thread_join(t);
            return r;
        }
        if (clock_now_ms() >= deadline) {
            return 0;
        }
        sleep_ms(1);
    }
    return 0;
}

# Build "step timeout: {name} after {ms}ms" (SzalError::StepTimeout Display, error.rs). name is Str.
fn _step_timeout_msg(name, timeout_ms) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "step timeout: ");
    str_builder_add(sb, name);
    str_builder_add_cstr(sb, " after ");
    str_builder_add_int(sb, timeout_ms);
    str_builder_add_cstr(sb, "ms");
    return str_builder_build(sb);
}

# Build "retry exhausted: {name} after {attempts} attempts" (SzalError::RetryExhausted Display).
fn _retry_exhausted_msg(name, attempts) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "retry exhausted: ");
    str_builder_add(sb, name);
    str_builder_add_cstr(sb, " after ");
    str_builder_add_int(sb, attempts);
    str_builder_add_cstr(sb, " attempts");
    return str_builder_build(sb);
}

# The step_type as a cstr for emit_step_type_metric, or 0 (None) -> the helper maps it to "default".
fn _step_type_cstr(step) {
    var st = step_step_type(step);
    if (st == 0) { return 0; }
    return str_cstr(st);
}

# Execute a step with its handler: emit step_started once, then up to (max_retries + 1) attempts
# with per-attempt timeout, retry events, and backoff sleeps; on success return Completed, else
# (after all attempts) Failed. Mirrors execute_step_with_handler (step_exec.rs 9-179) exactly,
# including durations (per-attempt on success, TOTAL on final failure), the RetryExhausted vs
# last-error final message, and the completed/failed step-type metrics. `ctx` is an ExecCtx.
fn execute_step_with_handler(step, ctx) {
    var handler = exec_ctx_handler(ctx);
    var event_sink = exec_ctx_event_sink(ctx);
    var flow = exec_ctx_flow(ctx);
    var metrics_vt = exec_ctx_metrics_vt(ctx);
    var stm = exec_ctx_step_type_metrics(ctx);
    var fname = flow_ctx_name(flow);
    var name = step_name(step);
    var sid = uuid_to_str(step_id_hi(step), step_id_lo(step));
    var max_attempts = step_max_retries(step) + 1;
    var timeout_ms = step_timeout_ms(step);
    var last_error = 0;
    var total_start = clock_now_ms();

    # step_started emitted ONCE, before the attempt loop.
    emit(event_sink, event_step_started(name, sid));
    metric_step_started(metrics_vt, fname, name);

    var attempt = 1;
    while (attempt <= max_attempts) {
        var step_start = clock_now_ms();
        var r = _run_attempt(handler, step, timeout_ms);
        var dur = clock_now_ms() - step_start;

        if (r == 0) {
            # Timeout: emit step_failed WITH the per-attempt duration (step_exec.rs 45-54), then
            # treat as a failed attempt for the retry/backoff logic.
            var terr = _step_timeout_msg(name, timeout_ms);
            var tev = event_step_failed(name, sid, terr, attempt);
            _event_with_duration(tev, dur);
            emit(event_sink, tev);
            last_error = terr;
            if (attempt < max_attempts) {
                emit(event_sink, event_step_retry(name, sid, attempt));
                sleep_ms(step_backoff_delay_ms(step_backoff(step), step_retry_delay_ms(step), attempt));
            }
        } elif (is_ok(r) == 1) {
            # Success: Completed, per-attempt duration, attempts = this attempt.
            var output = result_unwrap(r);
            emit(event_sink, event_step_completed(name, sid, dur, attempt));
            metric_step_finished(metrics_vt, fname, name, str_from("completed"), dur);
            emit_step_type_metric(stm, _step_type_cstr(step), "completed", dur);
            return step_result_new(step_id_hi(step), step_id_lo(step), STATUS_COMPLETED, output,
            dur, attempt);
        } else {
            # Handler error: emit step_retry if more attempts remain; record last_error; backoff.
            var e = err_code_of(r);
            if (attempt < max_attempts) {
                emit(event_sink, event_step_retry(name, sid, attempt));
            }
            last_error = e;
            if (attempt < max_attempts) {
                sleep_ms(step_backoff_delay_ms(step_backoff(step), step_retry_delay_ms(step), attempt));
            }
        }
        attempt = attempt + 1;
    }

    # All attempts exhausted. Final error = RetryExhausted message when retries were configured
    # (max_attempts > 1), else the last handler error. Duration = TOTAL elapsed. Output = null.
    var error = last_error;
    if (max_attempts > 1) { error = _retry_exhausted_msg(name, max_attempts); }
    var total_dur = clock_now_ms() - total_start;

    var evmsg = error;
    if (evmsg == 0) { evmsg = str_from("unknown"); }
    emit(event_sink, event_step_failed(name, sid, evmsg, max_attempts));
    metric_step_finished(metrics_vt, fname, name, str_from("failed"), total_dur);
    emit_step_type_metric(stm, _step_type_cstr(step), "failed", total_dur);

    var res = step_result_new(step_id_hi(step), step_id_lo(step), STATUS_FAILED,
    bayan_json_v_null(), total_dur, max_attempts);
    step_result_set_error(res, error);
    return res;
}
