# szal — Cyrius port (from 13172 lines of Rust, frozen at rust-old/, git tag 1.2.0)
# Workflow engine: step/flow execution with branching, retry, rollback, DAG + parallel stages.
#
# Includes are explicit (cyrius 6.x: `cyrius lib sync` provisions ./lib/; the entry must
# `include` what it uses). Order is single-pass dependency order — stdlib first, then szal
# modules in the port-plan §4 topological order. Project modules are added as they land.

# --- Standard library (single-pass dependency order; proven by tests/szal_core.tcyr) ---
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/freelist.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/hashmap.cyr"
include "lib/syscalls.cyr"
include "lib/tagged.cyr"
include "lib/result.cyr"
include "lib/fnptr.cyr"
include "lib/trait.cyr"
include "lib/assert.cyr"
include "lib/io.cyr"
include "lib/bayan.cyr"
include "lib/chrono.cyr"
include "lib/sakshi.cyr"
include "lib/log.cyr"
include "lib/thread.cyr"
include "lib/async.cyr"

# --- vendored deps (hoosh pattern). Full majra 2.4.6 dist with szal-collision renames applied
# (MJ_ERR_/MJ_STEP_/MJ_TRIGGER_ + majra_uuid_generate/majra_step_result_new) — synced by
# scripts/sync-majra.sh. See docs/development/majra-vendoring.md. ---
include "src/vendor/majra.cyr"

# --- szal foundation modules (port-plan §4 topological order) ---
include "src/error.cyr"
include "src/state.cyr"
include "src/uuid.cyr"
include "src/md5.cyr"
include "src/bus.cyr"
include "src/step.cyr"
include "src/condition.cyr"
include "src/flow.cyr"
include "src/migration.cyr"
include "src/engine_result.cyr"
include "src/storage.cyr"
include "src/metrics.cyr"
include "src/engine_core.cyr"
include "src/engine_step_exec.cyr"
include "src/engine_sequential.cyr"
include "src/engine_hierarchical.cyr"
include "src/engine_parallel.cyr"
include "src/engine_dag.cyr"
include "src/engine_queue_runner.cyr"
include "src/engine_distributed.cyr"
include "src/engine_runner.cyr"

fn main() {
    alloc_init();
    # Route sakshi to its ring buffer so otel sink / log output never pollutes stdout.
    sakshi_output_buffer();

    # Smoke the composed foundation surface: build a 2-step linear DAG and validate it.
    # (Proves every foundation module links into the entry TU; full assertions live in
    # tests/szal_core.tcyr.)
    var build = step_new(str_from("build"));
    var deploy = step_new(str_from("deploy"));
    step_depends_on_add(deploy, step_id_hi(build), step_id_lo(build));
    var pipe = flow_new(str_from("pipeline"), FLOW_DAG);
    flow_add_step(pipe, build);
    flow_add_step(pipe, deploy);

    if (is_ok(flow_validate(pipe))) {
        println("szal ready");
        return 0;
    }
    println("szal: foundation smoke failed");
    return 1;
}

var r = main();
syscall(SYS_EXIT, r);
