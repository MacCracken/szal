# sql_store.cyr — durable patra-backed ExecutionStore
#
# Ports rust-old/src/sql_store.rs (port-plan §4 row 23). Rust backs the ExecutionStore with sqlx
# (SQLite + a feature-gated Postgres twin generated by a `macro_rules!`). The port targets **patra**
# (the stdlib SQL engine) only — **Postgres is dropped for 2.0.0** (port-plan §3.4 / roadmap "open
# question Q6"), so the macro collapses to a single concrete store.
#
# Records are stored as JSON in one `szal_executions` table, keyed by execution id, filterable by
# flow name. The schema diverges from Rust's `TEXT TEXT TEXT` to fit patra's column model:
#   CREATE TABLE szal_executions (execution_id STR, flow_name STR, data TEXT)
# WHY: patra's variable-length `TEXT` column is chain-page-backed and **is not WHERE-matchable**
# (lib/patra.cyr: "COL_BYTES / COL_TEXT: WHERE never matches"), and patra has NO `PRIMARY KEY`. The
# two columns we filter on (execution_id, flow_name) must therefore be the fixed 256-byte `STR` type
# (WHERE-matchable); only the large serialized record goes in a `TEXT` column. A UUID id (36 chars)
# and a flow name both fit comfortably in 256 bytes. See parity-notes §10.
#
# Two more patra-shaped divergences from Rust, both behavior-preserving:
#   - **Upsert = DELETE-then-INSERT.** patra has no `ON CONFLICT ... DO UPDATE`; only `INSERT` writes
#     a `TEXT` column (UPDATE-of-TEXT is unsupported), so `save` deletes any existing row for the id
#     then inserts. Single-row-per-id is preserved; "Running must not overwrite a later Completed" is
#     satisfied trivially because writes are SYNCHRONOUS.
#   - **Synchronous writes, no SpawnSink.** Rust's `engine_sink` is fire-and-forget over an ordered
#     background writer + in-memory mirror (to keep submission order). patra writes synchronously
#     (port-plan §3.4 recommends exactly this for 2.0.0), so ordering is inherent and the mirror /
#     writer task / `Once` machinery all vanish — `engine_sink` is a thin synchronous vtable over the
#     store. ADR 0001's ordering guarantee holds.
#
# Usage: include "src/sql_store.cyr" (after storage.cyr + engine_result.cyr + lib/patra.cyr).
# Requires: lib/patra.cyr (patra_*), lib/trait.cyr (trait_obj_new), src/storage.cyr (ExecutionRecord
#   + execution_record_to_json/from_json + the ExecutionStore vtable slot constants ES_*/ES_VTABLE_SIZE),
#   lib/str.cyr, lib/vec.cyr, lib/string.cyr (memcpy).
# Naming: public symbols are sqlite_store_-prefixed (echoing Rust SqliteExecutionStore); the engine
#   sink vtable + slot fns are internal (_sql_es_).

# The szal_executions DDL (idempotent via migrate's PATRA_ERR_EXISTS handling).
var _SQL_CREATE = "CREATE TABLE szal_executions (execution_id STR, flow_name STR, data TEXT)";
var _SQL_INSERT = "INSERT INTO szal_executions (execution_id, flow_name, data) VALUES (?, ?, ?)";
var _SQL_DELETE = "DELETE FROM szal_executions WHERE execution_id = ?";
var _SQL_SELECT = "SELECT data FROM szal_executions WHERE execution_id = ?";
var _SQL_LIST_ALL = "SELECT execution_id FROM szal_executions";
var _SQL_LIST_FLOW = "SELECT execution_id FROM szal_executions WHERE flow_name = ?";

# Bind a Str to placeholder `idx` of a prepared statement (text bind = WHERE-matchable COL_STR).
fn _sql_bind_str(stmt, idx, s) {
    return patra_bind_text(stmt, idx, str_data(s), str_len(s));
}

# Open (or create) the patra database at `path` (a cstr). Initializes the SQL engine. Returns the db
# handle, or 0 on failure. Mirrors SqliteExecutionStore::connect (sans the URL — patra is file-path
# based). Call sqlite_store_migrate once after.
fn sqlite_store_connect(path) {
    patra_init();
    return patra_open(path);
}

# Close the patra database. Mirrors dropping the pool.
fn sqlite_store_close(db) {
    return patra_close(db);
}

# Create the szal_executions table if it does not exist. Idempotent: a re-run returns PATRA_OK
# (patra reports PATRA_ERR_EXISTS for an existing table — patra has no CREATE TABLE IF NOT EXISTS).
# Mirrors SqliteExecutionStore::migrate. Returns PATRA_OK or a patra error code.
fn sqlite_store_migrate(db) {
    var rc = patra_exec(db, _SQL_CREATE);
    if (rc == PATRA_ERR_EXISTS) { return PATRA_OK; }
    return rc;
}

# Delete any row for execution id `eid` (a Str). Internal helper for save (upsert) + remove.
fn _sql_delete(db, eid) {
    var del = patra_prepare(db, _SQL_DELETE);
    if (del == 0) { return 0; }
    _sql_bind_str(del, 0, eid);
    patra_exec_prepared(db, del);
    patra_finalize(del);
    return 0;
}

# Persist (insert or replace) an ExecutionRecord. Upsert = delete-then-insert (patra has no
# ON CONFLICT). The full record is serialized to JSON in the `data` TEXT column; execution_id +
# flow_name are duplicated into their own STR columns for keying/filtering. Mirrors
# SqliteExecutionStore::save (sync). Returns 0.
fn sqlite_store_save(db, record) {
    var eid = execution_record_execution_id(record);
    var fname = execution_record_flow_name(record);
    var data = execution_record_to_json(record);
    _sql_delete(db, eid);
    var ins = patra_prepare(db, _SQL_INSERT);
    if (ins == 0) { return 0; }
    _sql_bind_str(ins, 0, eid);
    _sql_bind_str(ins, 1, fname);
    _sql_bind_str(ins, 2, data);
    patra_exec_prepared(db, ins);
    patra_finalize(ins);
    return 0;
}

# Load an ExecutionRecord by id (a Str). Returns the record* (rebuilt from its JSON `data` column),
# or 0 (None) if absent. Mirrors SqliteExecutionStore::get.
fn sqlite_store_get(db, eid) {
    var q = patra_prepare(db, _SQL_SELECT);
    if (q == 0) { return 0; }
    _sql_bind_str(q, 0, eid);
    var rs = patra_query_prepared(db, q);
    patra_finalize(q);
    if (rs == 0) { return 0; }
    if (patra_result_count(rs) == 0) {
        patra_result_free(rs);
        return 0;
    }
    var rec = 0;
    var tlen = patra_result_get_text_len(rs, 0, 0);
    if (tlen > 0) {
        var out = alloc(tlen);
        patra_result_read_text(db, rs, 0, 0, out);
        var json = str_new(out, tlen);
        rec = execution_record_from_json(json);
    }
    patra_result_free(rs);
    return rec;
}

# Append every execution_id in result set `rs` (column 0, an STR column) to `out` as a fresh-copied
# Str (the rs slot is freed after this). Internal.
fn _sql_collect_ids(rs, out) {
    var n = patra_result_count(rs);
    var i = 0;
    while (i < n) {
        var slen = patra_result_get_str_len(rs, i, 0);
        var sptr = patra_result_get_str(rs, i, 0);
        var copy = alloc(slen);
        memcpy(copy, sptr, slen);
        vec_push(out, str_new(copy, slen));
        i = i + 1;
    }
    return 0;
}

# List execution ids, optionally filtered by flow name (a Str, or 0 for all). Returns a vec of Str.
# Mirrors SqliteExecutionStore::list.
fn sqlite_store_list(db, flow_filter) {
    var out = vec_new();
    if (flow_filter == 0) {
        var rs_all = patra_query(db, _SQL_LIST_ALL);
        if (rs_all == 0) { return out; }
        _sql_collect_ids(rs_all, out);
        patra_result_free(rs_all);
        return out;
    }
    var q = patra_prepare(db, _SQL_LIST_FLOW);
    if (q == 0) { return out; }
    _sql_bind_str(q, 0, flow_filter);
    var rs = patra_query_prepared(db, q);
    patra_finalize(q);
    if (rs == 0) { return out; }
    _sql_collect_ids(rs, out);
    patra_result_free(rs);
    return out;
}

# Remove an execution record by id (a Str), returning the removed record* or 0 (None). Mirrors
# SqliteExecutionStore::remove (get-then-delete).
fn sqlite_store_remove(db, eid) {
    var rec = sqlite_store_get(db, eid);
    if (rec == 0) { return 0; }
    _sql_delete(db, eid);
    return rec;
}

# --- ExecutionStore trait adapter (engine_sink): synchronous vtable over the store ---

fn _sql_es_save(db, record) { return sqlite_store_save(db, record); }
fn _sql_es_get(db, eid) { return sqlite_store_get(db, eid); }
fn _sql_es_list(db, flow_filter) { return sqlite_store_list(db, flow_filter); }
fn _sql_es_remove(db, eid) { return sqlite_store_remove(db, eid); }

var _sql_es_vt = 0;

fn _sql_es_vtable() {
    if (_sql_es_vt == 0) {
        var vt = alloc(ES_VTABLE_SIZE);
        store64(vt + 0, &_sql_es_save);
        store64(vt + 8, &_sql_es_get);
        store64(vt + 16, &_sql_es_list);
        store64(vt + 24, &_sql_es_remove);
        _sql_es_vt = vt;
    }
    return _sql_es_vt;
}

# Adapt the store to the synchronous ExecutionStore trait object the engine consumes (the data ptr
# is the patra db handle). Plug into engine_with_execution_store. Writes are synchronous, so the
# Rust SpawnSink mirror/ordered-writer is unnecessary (see module header). Mirrors
# SqliteExecutionStore::engine_sink.
fn sqlite_store_engine_sink(db) {
    return trait_obj_new(_sql_es_vtable(), db);
}
