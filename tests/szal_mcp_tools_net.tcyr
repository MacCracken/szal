fn _call(fp, args) {
    var c = fncall2(fp, args, 0);
    return str_from(c);
}

fn _result_text(r) {
    var o = bayan_json_v_parse(r);
    var content = bayan_json_v_obj_get(o, "content");
    var item = bayan_json_v_arr_get(content, 0);
    return bayan_json_v_str(bayan_json_v_obj_get(item, "text"));
}

# --- szal_http SSRF guard ---

# A non-http(s) scheme is rejected. (net_tools.rs 500-506)
fn t_http_file_url() {
    var r = _call(&_http_handler, "{\"url\": \"file:///etc/passwd\"}");
    assert(str_contains(r, str_from("\"isError\":true")), "file URL rejected");
    assert(str_contains(r, str_from("http://")), "scheme message");
    return 0;
}

# localhost is blocked. (net_tools.rs 508-516)
fn t_http_localhost() {
    var r = _call(&_http_handler, "{\"url\": \"http://localhost/admin\"}");
    assert(str_contains(r, str_from("\"isError\":true")), "localhost blocked");
    assert(str_contains(r, str_from("private/internal")), "private message");
    return 0;
}

# The cloud-metadata endpoint is blocked. (net_tools.rs 518-526)
fn t_http_metadata() {
    var r = _call(&_http_handler, "{\"url\": \"http://169.254.169.254/latest/meta-data/\"}");
    assert(str_contains(r, str_from("\"isError\":true")), "metadata blocked");
    assert(str_contains(r, str_from("blocked")), "blocked message");
    return 0;
}

# Private IP ranges (192.168/10/172.16) are blocked. (net_tools.rs 528-540)
fn t_http_private() {
    var a = _call(&_http_handler, "{\"url\": \"http://192.168.1.1/\"}");
    assert(str_contains(a, str_from("\"isError\":true")), "192.168 blocked");
    var b = _call(&_http_handler, "{\"url\": \"http://10.0.0.1/\"}");
    assert(str_contains(b, str_from("\"isError\":true")), "10.x blocked");
    var c = _call(&_http_handler, "{\"url\": \"http://172.16.0.1/\"}");
    assert(str_contains(c, str_from("\"isError\":true")), "172.16 blocked");
    # 172.15 is NOT private — passes the SSRF guard (will fail later at curl, but not blocked here).
    var d = _call(&_http_handler, "{\"url\": \"http://8.8.8.8:1/\"}");
    assert_eq(str_contains(d, str_from("private/internal")), 0, "public IP not SSRF-blocked");
    return 0;
}

# Missing url is a validation error.
fn t_http_missing() {
    var r = _call(&_http_handler, "{}");
    assert(str_contains(r, str_from("\"isError\":true")), "no url -> error");
    assert(str_contains(r, str_from("missing required field: url")), "validation message");
    return 0;
}

# --- szal_dns_lookup ---

# localhost resolves to a loopback address. (net_tools.rs 420-426)
fn t_dns_localhost() {
    var r = _call(&_dns_handler, "{\"hostname\": \"localhost\"}");
    assert(str_contains(r, str_from("\"isError\":false")), "dns localhost ok");
    var text = _result_text(r);
    var has = 0;
    if (str_contains(text, str_from("127.0.0.1")) == 1) { has = 1; }
    if (str_contains(text, str_from("::1")) == 1) { has = 1; }
    assert_eq(has, 1, "resolves to loopback");
    return 0;
}

# An invalid hostname errors. (net_tools.rs 428-434)
fn t_dns_invalid() {
    var r = _call(&_dns_handler, "{\"hostname\": \"this.host.does.not.exist.invalid\"}");
    assert(str_contains(r, str_from("\"isError\":true")), "invalid host errors");
    return 0;
}

# --- szal_port_check ---

# A closed port reports open:false. (net_tools.rs 436-443)
fn t_port_closed() {
    var r = _call(&_port_check_handler, "{\"port\": 1, \"timeout_ms\": 500}");
    assert(str_contains(r, str_from("\"isError\":false")), "port check ok");
    assert(str_contains(_result_text(r), str_from("\"open\": false")), "port 1 closed");
    return 0;
}

# An out-of-range port is rejected. (net_tools.rs 492-498)
fn t_port_invalid() {
    var r = _call(&_port_check_handler, "{\"port\": 70000}");
    assert(str_contains(r, str_from("\"isError\":true")), "bad port rejected");
    assert(str_contains(r, str_from("out of range")), "range message");
    return 0;
}

# --- szal_url_encode ---

# Encoding percent-escapes reserved characters. (net_tools.rs 445-454)
fn t_url_encode() {
    var r = _call(&_url_encode_handler, "{\"input\": \"hello world & foo=bar\"}");
    assert(str_eq_cstr(_result_text(r), "hello%20world%20%26%20foo%3Dbar"), "encodes reserved chars");
    return 0;
}

# Decoding reverses percent-escapes. (net_tools.rs 456-465)
fn t_url_decode() {
    var r = _call(&_url_encode_handler, "{\"input\": \"hello%20world\", \"operation\": \"decode\"}");
    assert(str_eq_cstr(_result_text(r), "hello world"), "decodes percent escapes");
    return 0;
}

# Encode/decode round-trips. (net_tools.rs 467-476)
fn t_url_roundtrip() {
    var enc = _call(&_url_encode_handler, "{\"input\": \"spaces & symbols/here?yes=true\"}");
    var enc_text = _result_text(enc);
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("input"), bayan_json_v_str_new(enc_text));
    bayan_json_v_obj_set(o, str_from("operation"), bayan_json_v_str_new(str_from("decode")));
    var dec = _call(&_url_encode_handler, str_cstr(bayan_json_v_build(o)));
    assert(str_eq_cstr(_result_text(dec), "spaces & symbols/here?yes=true"), "round-trips");
    return 0;
}

# --- aggregator ---

# szal_all_tools() / szal_register_tools() wires every group into one dispatcher.
fn t_all_tools() {
    var all = szal_all_tools();
    assert_eq(vec_len(all), 54, "54 built-in tools");
    var d = szal_register_tools();
    assert(d != 0, "dispatcher built");
    assert_eq(registry_len(dispatcher_registry(d)), 54, "54 tools registered");
    assert_eq(registry_contains(dispatcher_registry(d), "szal_uuid"), 1, "encoding present");
    assert_eq(registry_contains(dispatcher_registry(d), "szal_http"), 1, "net present");
    assert_eq(registry_contains(dispatcher_registry(d), "szal_git_status"), 1, "git present");
    assert_eq(registry_contains(dispatcher_registry(d), "szal_math_eval"), 1, "math present");
    return 0;
}

# --- the condition parser, with EVERY tool module compiled in after it (main.cyr's order) ---
# szal <= 2.1.2: mcp_tools_math.cyr redeclared condition.cyr's TOK_LPAREN/TOK_RPAREN (13/14 -> 6/7)
# and, past var index 1024, the later enum value wins for every read — so here `(` lexed as TOK_GT
# and `)` as TOK_GTE, and `(x)` / `!(x)` / `x == (1)` stopped parsing. The condition suites never
# saw it: none of them include the math tool. This suite includes both, in main.cyr's order.
fn _tp_ctx(j) { return bayan_json_v_parse(j); }
fn _tp_ok(expr, want, name) {
    var ctx = _tp_ctx(str_from("{\"x\": 1}"));
    var t, v = cond_evaluate(str_from(expr), ctx);
    assert_eq(is_ok(t), 1, name);
    assert_eq(v, want, name);
    return 0;
}
fn t_condition_parens() {
    _tp_ok("(x)", 1, "(x) parses");
    _tp_ok("(x) == 1", 1, "(x) == 1 parses");
    _tp_ok("!(x)", 0, "!(x) parses");
    _tp_ok("((x == 1))", 1, "nested parens parse");
    _tp_ok("x == (1)", 1, "parenthesised operand parses");
    _tp_ok("x >= 1 && (x <= 1)", 1, ">= beside parens");
    # A stray ')' must be reported as ')', not as the '>=' it used to alias.
    var ctx = _tp_ctx(str_from("{\"x\": 1}"));
    var t, v = cond_evaluate(str_from("x == 1)"), ctx);
    assert_eq(is_err_result(t), 1, "trailing ) is an error");
    var msg = szal_get_err_msg();
    assert_eq(str_contains(msg, str_from(")")), 1, "error names the ) token");
    assert_eq(str_contains(msg, str_from(">=")), 0, "error does not call it >=");
    return 0;
}

# --- the consumer shape: add szal's tools to a dispatcher the consumer already owns ---
# hoosh builds its own registry + dispatcher (bote_echo, its audit chain, its event bus) and needs
# szal's 54 tools next to them, under ITS sinks — szal_register_into, not a szal-built dispatcher.
var _reg_events = 0;
fn _count_registered(ctx, topic, payload) {
    if (streq(topic, TOPIC_TOOL_REGISTERED()) == 1) { _reg_events = _reg_events + 1; }
    return 0;
}
fn _echo_tool(args, claims) {
    return "{\"content\":[{\"type\":\"text\",\"text\":\"consumer-echo\"}],\"isError\":false}";
}
# Run one JSON-RPC message through bote's codec against `d`; return the parsed `result` object.
fn _rpc_result(d, msg) {
    var out = codec_process_message(msg, d, 0);
    var o = _tp_ctx(str_from(out));
    return bayan_json_v_obj_get(o, "result");
}
# The text of a tools/call result: result.content[0].text.
fn _rpc_text(d, msg) {
    var res = _rpc_result(d, msg);
    var item = bayan_json_v_arr_get(bayan_json_v_obj_get(res, "content"), 0);
    return bayan_json_v_str(bayan_json_v_obj_get(item, "text"));
}
fn t_register_into() {
    var d = dispatcher_new(tool_registry_new());
    dispatcher_set_events(d, event_sink_new(&_count_registered, 0));
    var td = tool_def_new("consumer_echo", "Echo", schema_new("object", vec_new(), vec_new()));
    dispatcher_register_tool(d, td, &_echo_tool);
    assert_eq(registry_len(dispatcher_registry(d)), 1, "consumer dispatcher starts with its own tool");

    _reg_events = 0;
    assert_eq(szal_register_into(d), 0, "szal_register_into succeeds");
    assert_eq(registry_len(dispatcher_registry(d)), 55, "54 szal tools join the consumer's one");
    var list = _rpc_result(d, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}");
    assert_eq(bayan_json_v_arr_len(bayan_json_v_obj_get(list, "tools")), 55, "tools/list returns 55");
    assert_eq(registry_contains(dispatcher_registry(d), "consumer_echo"), 1, "consumer tool kept");
    assert_eq(registry_contains(dispatcher_registry(d), "szal_math_eval"), 1, "szal tool added");
    assert_eq(_reg_events, 54, "consumer's event sink heard all 54 registrations");

    # Both kinds of tool dispatch through the consumer's dispatcher.
    var echo = _rpc_text(d, "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"consumer_echo\",\"arguments\":{}}}");
    assert(str_eq_cstr(echo, "consumer-echo") == 1, "consumer tool still dispatches");
    var five = _rpc_text(d, "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"szal_math_eval\",\"arguments\":{\"expression\":\"2 + 3\"}}}");
    assert(str_eq_cstr(five, "5") == 1, "szal tool dispatches via the consumer's dispatcher");

    # Registering again replaces by name instead of duplicating.
    assert_eq(szal_register_into(d), 0, "second szal_register_into succeeds");
    assert_eq(registry_len(dispatcher_registry(d)), 55, "re-registering keeps 55");
    return 0;
}

# szal_register_tools_with(audit, events) — Rust's register_tools_with: all tools, caller's sinks.
fn t_register_tools_with() {
    var ev = event_sink_new(&_count_registered, 0);
    var d = szal_register_tools_with(0, ev);
    assert_eq(registry_len(dispatcher_registry(d)), 54, "register_tools_with: 54 tools");
    assert_eq(dispatcher_event_sink(d), ev, "register_tools_with: event sink attached");
    assert_eq(dispatcher_audit_sink(d), 0, "register_tools_with: audit None stays None");
    return 0;
}

# Net group registers its 4 tools.
fn t_group_registers() {
    var d = szal_register_tool_vec(szal_net_tools());
    assert_eq(registry_contains(dispatcher_registry(d), "szal_http"), 1, "http registered");
    assert_eq(registry_contains(dispatcher_registry(d), "szal_dns_lookup"), 1, "dns registered");
    assert_eq(registry_contains(dispatcher_registry(d), "szal_port_check"), 1, "port_check registered");
    assert_eq(registry_contains(dispatcher_registry(d), "szal_url_encode"), 1, "url_encode registered");
    assert_eq(registry_len(dispatcher_registry(d)), 4, "four net tools");
    return 0;
}

fn main() {
    alloc_init();

    test_group("szal_http SSRF guard");
    t_http_file_url();
    t_http_localhost();
    t_http_metadata();
    t_http_private();
    t_http_missing();

    test_group("szal_dns_lookup");
    t_dns_localhost();
    t_dns_invalid();

    test_group("szal_port_check");
    t_port_closed();
    t_port_invalid();

    test_group("szal_url_encode");
    t_url_encode();
    t_url_decode();
    t_url_roundtrip();

    test_group("aggregator + registration");
    t_all_tools();
    t_group_registers();
    t_register_into();
    t_register_tools_with();

    test_group("condition parser beside every tool module");
    t_condition_parens();

    var rc = assert_summary();
    return rc;
}

var exit_code = main();
syscall(60, exit_code);
