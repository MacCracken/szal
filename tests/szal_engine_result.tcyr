# szal_engine_result.tcyr — FlowResult (engine_result.cyr) unit tests.
#
# Ports the engine/result.rs + engine/mod.rs FlowResult assertions: completed/failed/skipped
# counts and serde round-trip. Build:
#   cyrius build --strict --no-deps tests/szal_engine_result.tcyr build/test_engine_result
#   ./build/test_engine_result

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/freelist.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/hashmap.cyr"
include "lib/syscalls.cyr"
include "lib/tagged.cyr"
include "lib/result.cyr"
include "lib/fnptr.cyr"
include "lib/assert.cyr"
include "lib/io.cyr"
include "lib/bayan.cyr"
include "src/error.cyr"
include "src/uuid.cyr"
include "src/step.cyr"
include "src/engine_result.cyr"

# Does Str s contain the cstr substring `needle`? Field-presence helper for JSON assertions.
fn contains_cstr(s, needle) {
    var data = str_data(s);
    var slen = str_len(s);
    var nlen = strlen(needle);
    if (nlen == 0) { return 1; }
    if (nlen > slen) { return 0; }
    var i = 0;
    while (i <= slen - nlen) {
        var j = 0;
        var ok = 1;
        while (j < nlen) {
            if (load8(data + i + j) != load8(needle + j)) { ok = 0; j = nlen; }
            else { j = j + 1; }
        }
        if (ok == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Build a StepResult with a fresh id and an empty-object output. Mirrors the Rust test fixtures
# (serde_json::json!({})).
fn mk_result(status, duration_ms, attempts) {
    var hi, lo = uuid_generate();
    return step_result_new(hi, lo, status, bayan_json_v_obj_new(), duration_ms, attempts);
}

fn main() {
    alloc_init();

    # Mirrors engine/mod.rs tests::flow_result_counts — 2 steps (Completed, Failed), total 150.
    test_group("flow_result counts");
    var fr = flow_result_new(str_from("test"), 150, 0, 0);
    var s1 = mk_result(STATUS_COMPLETED, 100, 1);
    var s2 = mk_result(STATUS_FAILED, 50, 3);
    step_result_set_error(s2, str_from("timeout"));
    flow_result_add_step(fr, s1);
    flow_result_add_step(fr, s2);
    assert_eq(flow_result_steps_len(fr), 2, "two step results");
    assert_eq(flow_result_completed_count(fr), 1, "completed_count == 1");
    assert_eq(flow_result_failed_count(fr), 1, "failed_count == 1");
    assert_eq(flow_result_skipped_count(fr), 0, "skipped_count == 0");
    assert_eq(flow_result_total_duration_ms(fr), 150, "total_duration_ms");
    assert_eq(flow_result_success(fr), 0, "success false");
    assert_eq(flow_result_rolled_back(fr), 0, "rolled_back false");

    # skipped_count picks up a Skipped step.
    test_group("flow_result skipped_count");
    flow_result_add_step(fr, mk_result(STATUS_SKIPPED, 0, 0));
    assert_eq(flow_result_skipped_count(fr), 1, "skipped_count == 1 after add");
    assert_eq(flow_result_completed_count(fr), 1, "completed_count unchanged");

    # JSON shape: every field serializes (no skip attributes), field order is struct order.
    test_group("flow_result to_json shape");
    var fjson = flow_result_to_json(fr);
    assert_eq(contains_cstr(fjson, "\"flow_name\":\"test\""), 1, "json flow_name");
    assert_eq(contains_cstr(fjson, "\"total_duration_ms\":150"), 1, "json total_duration_ms");
    assert_eq(contains_cstr(fjson, "\"success\":false"), 1, "json success false");
    assert_eq(contains_cstr(fjson, "\"rolled_back\":false"), 1, "json rolled_back false");
    assert_eq(contains_cstr(fjson, "\"steps\":["), 1, "json steps array present");
    assert_eq(contains_cstr(fjson, "\"status\":\"Completed\""), 1, "json embeds step status");

    # Mirrors engine/mod.rs tests::flow_result_serde_roundtrip — 1 Completed step with an
    # object output, total 100, success true.
    test_group("flow_result serde round-trip");
    var hi, lo = uuid_generate();
    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("key"), bayan_json_v_str_new(str_from("value")));
    var only = step_result_new(hi, lo, STATUS_COMPLETED, out, 100, 1);
    var rr = flow_result_new(str_from("test"), 100, 1, 0);
    flow_result_add_step(rr, only);
    var rrjson = flow_result_to_json(rr);
    var back = flow_result_from_json(rrjson);
    assert(back != 0, "round-trip parse ok");
    assert(str_eq_cstr(flow_result_flow_name(back), "test"), "round-trip flow_name == test");
    assert_eq(flow_result_success(back), 1, "round-trip success true");
    assert_eq(flow_result_rolled_back(back), 0, "round-trip rolled_back false");
    assert_eq(flow_result_total_duration_ms(back), 100, "round-trip total_duration_ms");
    assert_eq(flow_result_steps_len(back), 1, "round-trip steps len == 1");
    var bs = flow_result_step_at(back, 0);
    assert_eq(step_result_status(bs), STATUS_COMPLETED, "round-trip step status");
    assert_eq(step_result_id_hi(bs), hi, "round-trip step id hi");
    assert_eq(step_result_duration_ms(bs), 100, "round-trip step duration");
    # the nested object output survived
    var bout = step_result_output(bs);
    assert(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(bout, "key")), "value"),
    "round-trip nested output.key == value");

    # empty FlowResult round-trips to empty steps + zero counts.
    test_group("flow_result empty round-trip");
    var empty = flow_result_new(str_from("e"), 0, 0, 0);
    var ejson = flow_result_to_json(empty);
    var eb = flow_result_from_json(ejson);
    assert_eq(flow_result_steps_len(eb), 0, "empty round-trip no steps");
    assert_eq(flow_result_completed_count(eb), 0, "empty completed_count 0");

    var rc = assert_summary();
    return rc;
}

var exit_code = main();
syscall(60, exit_code);
