# szal_error.tcyr — error code + detail-buffer parity tests for src/error.cyr
# Run: cyrius build --no-deps tests/szal_error.tcyr build/test_error && ./build/test_error

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/freelist.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/hashmap.cyr"
include "lib/syscalls.cyr"
include "lib/tagged.cyr"
include "lib/result.cyr"
include "lib/fnptr.cyr"
include "lib/assert.cyr"
include "src/error.cyr"

fn main() {
    alloc_init();

    test_group("szal error codes");
    assert_eq(SZAL_ERR_NONE, 0, "SZAL_ERR_NONE is 0");
    assert_eq(SZAL_ERR_STEP_FAILED, 1, "SZAL_ERR_STEP_FAILED is 1");
    assert_eq(SZAL_ERR_STEP_TIMEOUT, 2, "SZAL_ERR_STEP_TIMEOUT is 2");
    assert_eq(SZAL_ERR_FLOW_INVALID, 3, "SZAL_ERR_FLOW_INVALID is 3");
    assert_eq(SZAL_ERR_RETRY_EXHAUSTED, 4, "SZAL_ERR_RETRY_EXHAUSTED is 4");
    assert_eq(SZAL_ERR_ROLLBACK_FAILED, 5, "SZAL_ERR_ROLLBACK_FAILED is 5");
    assert_eq(SZAL_ERR_CYCLE, 6, "SZAL_ERR_CYCLE is 6");
    assert_eq(SZAL_ERR_MIGRATION, 7, "SZAL_ERR_MIGRATION is 7");
    assert_eq(SZAL_ERR_HW_UNAVAILABLE, 8, "SZAL_ERR_HW_UNAVAILABLE is 8");
    assert_eq(SZAL_ERR_QUEUE, 9, "SZAL_ERR_QUEUE is 9");
    assert_eq(SZAL_ERR_OTHER, 10, "SZAL_ERR_OTHER is 10");

    test_group("szal_err_name");
    assert_streq(szal_err_name(SZAL_ERR_NONE), "none", "name SZAL_ERR_NONE");
    assert_streq(szal_err_name(SZAL_ERR_STEP_FAILED), "step_failed", "name SZAL_ERR_STEP_FAILED");
    assert_streq(szal_err_name(SZAL_ERR_STEP_TIMEOUT), "step_timeout", "name SZAL_ERR_STEP_TIMEOUT");
    assert_streq(szal_err_name(SZAL_ERR_FLOW_INVALID), "flow_invalid", "name SZAL_ERR_FLOW_INVALID");
    assert_streq(szal_err_name(SZAL_ERR_RETRY_EXHAUSTED), "retry_exhausted", "name SZAL_ERR_RETRY_EXHAUSTED");
    assert_streq(szal_err_name(SZAL_ERR_ROLLBACK_FAILED), "rollback_failed", "name SZAL_ERR_ROLLBACK_FAILED");
    assert_streq(szal_err_name(SZAL_ERR_CYCLE), "cycle_detected", "name SZAL_ERR_CYCLE");
    assert_streq(szal_err_name(SZAL_ERR_MIGRATION), "migration_failed", "name SZAL_ERR_MIGRATION");
    assert_streq(szal_err_name(SZAL_ERR_HW_UNAVAILABLE), "hardware_unavailable", "name SZAL_ERR_HW_UNAVAILABLE");
    assert_streq(szal_err_name(SZAL_ERR_QUEUE), "queue_error", "name SZAL_ERR_QUEUE");
    assert_streq(szal_err_name(SZAL_ERR_OTHER), "other", "name SZAL_ERR_OTHER");
    assert_streq(szal_err_name(999), "unknown", "name unknown code");

    test_group("szal error detail buffer");
    szal_clear_err_msg();
    assert_eq(str_len(szal_get_err_msg()), 0, "cleared buffer is empty");
    szal_set_err_msg(str_from("boom: step failed"));
    assert_eq(str_len(szal_get_err_msg()), 17, "detail length after set");
    assert(str_eq_cstr(szal_get_err_msg(), "boom: step failed"), "detail content after set");
    szal_clear_err_msg();
    assert_eq(str_len(szal_get_err_msg()), 0, "cleared again");

    test_group("szal_err constructor returns Err(code)");
    var r = szal_err(SZAL_ERR_CYCLE, str_from("cycle in dag 'x'"));
    assert(is_err_result(r), "szal_err returns an Err");
    assert_eq(err_code_of(r), SZAL_ERR_CYCLE, "szal_err carries the code");
    assert(str_eq_cstr(szal_get_err_msg(), "cycle in dag 'x'"), "szal_err set the detail");

    var rc = assert_summary();
    return rc;
}

var exit_code = main();
syscall(60, exit_code);
